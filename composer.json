{
  "name": "triangle/console",
  "description": "Triangle Console Component",
  "type": "library",
  "keywords": [
    "localzet",
    "Triangle",
    "Console"
  ],
  "license": "AGPL-3.0-or-later",
  "authors": [
    {
      "role": "Developer",
      "name": "Ivan Zorin",
      "email": "creator@localzet.com",
      "homepage": "https://github.com/localzet"
    }
  ],
  "support": {
    "email": "support@localzet.com",
    "source": "https://github.com/Triangle-org/Console"
  },
  "autoload": {
    "psr-4": {
      "Triangle\\": "",
      "Triangle\\Console\\": "src"
    }
  },
  "require": {
    "php": "^8.4.1",
    "localzet/console": "^2.2",
    "triangle/engine": "^9.0",
    "symfony/console": "^8.1",
    "symfony/process": "^8.1"
  },
  "suggest": {
    "ext-zip": "For build bin",
    "ext-openssl": "For build phar (Phar::OPENSSL)"
  },
  "scripts": {
    "lint": "find . -path './vendor' -prune -o -path './.git' -prune -o -name '*.php' -type f -print0 | xargs -0 -n1 php -l",
    "test": "php tests/run.php",
    "check": [
      "@lint",
      "@test"
    ]
  },
  "config": {
    "platform": {
      "php": "8.4.1"
    }
  }
}
